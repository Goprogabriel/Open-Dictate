# Copy this file to release/release.env for local production builds.
# These values are public client configuration and are embedded in the app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_API_BASE_URL=https://REGION-PROJECT_ID.cloudfunctions.net/api
OPEN_DICTATE_MANAGED_API_ORIGIN=https://REGION-PROJECT_ID.cloudfunctions.net
VITE_ENABLE_PREVIEW_DATA=false
VITE_ENABLE_FIREBASE_EMULATORS=false

# Never put signing certificates, certificate passwords, Apple app-specific
# passwords, OpenAI keys, Stripe secret keys, or Firebase service credentials here.
# Export signing credentials in the shell or store them as GitHub Actions secrets.
