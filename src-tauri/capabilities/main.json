{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least-privilege capability for the main Open Dictate window.",
  "windows": ["main"],
  "platforms": ["macOS", "windows"],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    "allow-get-platform-info",
    "allow-list-microphones",
    "allow-get-permission-snapshot",
    "allow-request-microphone-permission",
    "allow-open-permission-settings",
    "allow-start-recording",
    "allow-stop-recording",
    "allow-cancel-recording",
    "allow-transcribe-byok",
    "allow-transcribe-managed",
    "allow-transcribe-local",
    "allow-get-local-model-status",
    "allow-download-local-models",
    "allow-uninstall-local-models",
    "allow-insert-text",
    "allow-copy-text",
    "allow-set-api-key",
    "allow-has-api-key",
    "allow-delete-api-key",
    "allow-test-api-key",
    "allow-load-secure-state",
    "allow-save-secure-state",
    "allow-get-autostart-enabled",
    "allow-set-autostart-enabled",
    "allow-set-run-in-background",
    "allow-update-hud-state"
  ]
}
