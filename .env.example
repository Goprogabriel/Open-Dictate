# Public desktop configuration. Copy this file to .env.local and replace the
# placeholders only if you want to run the optional managed backend.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=

# Region-specific Firebase Functions API URL, without a trailing slash.
VITE_API_BASE_URL=https://REGION-PROJECT_ID.cloudfunctions.net/api

# Optional development flags. Never enable preview data in a production build.
VITE_ENABLE_PREVIEW_DATA=false
VITE_ENABLE_FIREBASE_EMULATORS=false
