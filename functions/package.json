{
  "name": "open-dictate-functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase --config ../firebase.json --project demo-open-dictate emulators:exec --only firestore \"vitest run test/firestore.rules.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "stripe": "^22.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.3",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "firebase": "^12.18.0",
    "firebase-tools": "^15.29.0",
    "globals": "^17.12.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
