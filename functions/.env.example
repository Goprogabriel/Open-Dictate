# Example non-secret runtime parameters. Replace every billing and usage value
# with values appropriate for your deployment; these are intentionally generic.
ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420
STRIPE_PRO_MONTHLY_PRICE_ID=price_REPLACE_WITH_YOUR_MONTHLY_PRICE
STRIPE_TOPUP_5_PRICE_ID=price_REPLACE_WITH_YOUR_FIRST_TOPUP_PRICE
STRIPE_TOPUP_10_PRICE_ID=price_REPLACE_WITH_YOUR_SECOND_TOPUP_PRICE
STRIPE_TOPUP_20_PRICE_ID=price_REPLACE_WITH_YOUR_THIRD_TOPUP_PRICE
TOPUP_5_CREDITS=500000
TOPUP_10_CREDITS=1000000
TOPUP_20_CREDITS=2000000
SUBSCRIPTION_MARGIN_BPS=2000
TOPUP_5_MARGIN_BPS=2000
TOPUP_10_MARGIN_BPS=2000
TOPUP_20_MARGIN_BPS=2000
CHECKOUT_SUCCESS_URL=https://REGION-PROJECT_ID.cloudfunctions.net/api/billing/success
CHECKOUT_CANCEL_URL=https://REGION-PROJECT_ID.cloudfunctions.net/api/billing/cancel
BILLING_PORTAL_RETURN_URL=https://REGION-PROJECT_ID.cloudfunctions.net/api/account
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_POLISH_MODEL=gpt-5-mini
OPENAI_POLISH_MAX_OUTPUT_TOKENS=4096
OPENAI_FAILED_POLISH_INPUT_OVERHEAD_TOKENS=512
MONTHLY_INCLUDED_CREDITS=500000
TRANSCRIBE_CREDITS_PER_SECOND=60
TRANSCRIBE_CREDITS_PER_PROVIDER_TOKEN=1
POLISH_INPUT_CREDITS_PER_MILLION=1000000
POLISH_OUTPUT_CREDITS_PER_MILLION=6000000
RESERVE_CREDITS_PER_MIB=8000
MIN_REQUEST_RESERVE_CREDITS=3000
MAX_POLISH_RESERVE_CREDITS=60000
MAX_AUDIO_BYTES=25165824
MAX_AUDIO_DURATION_MS=600000

# Estimated provider-cost accounting. Revenue margins are recorded on the
# subscription/top-up grant ledger entries above, not applied universally to
# dictation usage. Increment the schedule version whenever a provider rate or
# estimation method changes.
COMMERCIAL_COST_SCHEDULE_VERSION=example-v1
OPENAI_TRANSCRIBE_COST_MICROUSD_PER_MINUTE=1
OPENAI_POLISH_INPUT_COST_MICROUSD_PER_MILLION_TOKENS=1
OPENAI_POLISH_OUTPUT_COST_MICROUSD_PER_MILLION_TOKENS=1

# Secrets are intentionally absent. Create these with Firebase Secret Manager:
# firebase functions:secrets:set OPENAI_API_KEY
# firebase functions:secrets:set STRIPE_SECRET_KEY
# firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
